[Logo-menu]
custom-icon-path='/usr/share/gnome-shell/extensions/logomenu@aryan_k/Resources/ublue-logo.svg'
hide-forcequit=true
menu-button-extensions-app='com.mattjakeman.ExtensionManager.desktop'
menu-button-icon-image=30
menu-button-icon-size=20
menu-button-software-center='/usr/bin/flatpak run io.github.kolunmi.Bazaar'
menu-button-system-monitor='/usr/bin/missioncenter-helper'
menu-button-terminal='xdg-terminal-exec'
show-activities-button=true
show-distroshelf=true
show-gamemode=false
show-lockscreen=false
show-power-option=false
symbolic-icon=true
use-custom-icon=false

[advanced-media-controller]
panel-font-size=16
panel-index=3
panel-position='left'
show-track-name=false

[alphabetical-app-grid]
folder-order-position='start'

[appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=0
tray-pos='right'

[blur-my-shell]
rounded-blur-found=true
settings-version=2

[blur-my-shell/appfolder]
brightness=0.59999999999999998
sigma=30

[blur-my-shell/applications]
pipeline='pipeline_default'

[blur-my-shell/coverflow-alt-tab]
pipeline='pipeline_default'

[blur-my-shell/dash-to-dock]
blur=true
brightness=0.28999999999999998
corner-radius=18
override-background=true
pipeline='pipeline_default_rounded'
sigma=7
static-blur=false
style-dash-to-dock=2

[blur-my-shell/lockscreen]
pipeline='pipeline_default'

[blur-my-shell/overview]
pipeline='pipeline_default'

[blur-my-shell/panel]
blur=true
brightness=0.59999999999999998
corner-radius=0
override-background=true
override-background-dynamically=false
pipeline='pipeline_default'
sigma=0
static-blur=false
style-panel=0

[blur-my-shell/popup]
blur=false
pipeline='pipeline_default_rounded'

[blur-my-shell/screenshot]
pipeline='pipeline_default'

[blur-my-shell/window-list]
brightness=0.59999999999999998
sigma=30

[caffeine]
cli-toggle=true
indicator-position-max=2
restore-state=true
user-enabled=true

[clipboard-history]
toggle-menu=['<Super>v']
window-width-percentage=55

[dash-to-dock]
background-opacity=0.80000000000000004
dash-max-icon-size=48
dock-position='BOTTOM'
height-fraction=0.90000000000000002
preferred-monitor=-2
preferred-monitor-by-connector='eDP-1'

[gradia-companion]
tool-settings={'freehand': ('#ff8800', 3.0), 'rectangle': ('#000000', 3.0), 'solid-rectangle': ('#000000', 3.0), 'highlighter': ('#ffdd00', 4.0), 'arrow': ('#000000', 3.0), 'stamp': ('#000000', 3.0), 'select': ('#000000', 4.0)}

[gsconnect]
devices=@as []
missing-openssl=false
name='bluefin'

[libpanel]
layout=[['gnome@main', 'quick-settings-audio-panel@rayzeq.github.io/main']]

[middleclickclose]
close-button-modifiers=['shift']

[quick-settings-audio-panel]
profiles-renames={'Renoir/Cezanne HDMI/DP Audio Controller': {'off': ('Off', 'Off'), 'pro-audio': ('Pro Audio', 'Pro Audio'), 'output:hdmi-surround71-extra3': ('Digital Surround 7.1 (HDMI 4) Output', 'Digital Surround 7.1 (HDMI 4) Output'), 'output:hdmi-surround-extra3': ('Digital Surround 5.1 (HDMI 4) Output', 'Digital Surround 5.1 (HDMI 4) Output'), 'output:hdmi-surround71-extra2': ('Digital Surround 7.1 (HDMI 3) Output', 'Digital Surround 7.1 (HDMI 3) Output'), 'output:hdmi-surround-extra2': ('Digital Surround 5.1 (HDMI 3) Output', 'Digital Surround 5.1 (HDMI 3) Output'), 'output:hdmi-surround71-extra1': ('Digital Surround 7.1 (HDMI 2) Output', 'Digital Surround 7.1 (HDMI 2) Output'), 'output:hdmi-surround-extra1': ('Digital Surround 5.1 (HDMI 2) Output', 'Digital Surround 5.1 (HDMI 2) Output'), 'output:hdmi-surround71': ('Digital Surround 7.1 (HDMI) Output', 'Digital Surround 7.1 (HDMI) Output'), 'output:hdmi-surround': ('Digital Surround 5.1 (HDMI) Output', 'Digital Surround 5.1 (HDMI) Output'), 'output:hdmi-stereo-extra3': ('Digital Stereo (HDMI 4) Output', 'Digital Stereo (HDMI 4) Output'), 'output:hdmi-stereo-extra2': ('Digital Stereo (HDMI 3) Output', 'Digital Stereo (HDMI 3) Output'), 'output:hdmi-stereo-extra1': ('Digital Stereo (HDMI 2) Output', 'Digital Stereo (HDMI 2) Output'), 'output:hdmi-stereo': ('Digital Stereo (HDMI) Output', 'Digital Stereo (HDMI) Output')}, 'Ryzen HD Audio Controller': {'off': ('Off', 'Off'), 'pro-audio': ('Pro Audio', 'Pro Audio'), 'input:analog-stereo': ('Analog Stereo Input', 'Analog Stereo Input'), 'output:analog-stereo': ('Analog Stereo Output', 'Analog Stereo Output'), 'output:analog-stereo+input:analog-stereo': ('Analog Stereo Duplex', 'Analog Stereo Duplex')}, 'soundcore Liberty 4 NC': {'off': ('Off', 'Off'), 'headset-head-unit-cvsd': ('Headset Head Unit (HSP/HFP, codec CVSD)', 'Headset Head Unit (HSP/HFP, codec CVSD)'), 'headset-head-unit': ('Headset Head Unit (HSP/HFP, codec MSBC)', 'Headset Head Unit (HSP/HFP, codec MSBC)'), 'a2dp-sink-sbc_xq': ('High Fidelity Playback (A2DP Sink, codec SBC-XQ)', 'High Fidelity Playback (A2DP Sink, codec SBC-XQ)'), 'a2dp-sink-sbc': ('High Fidelity Playback (A2DP Sink, codec SBC)', 'High Fidelity Playback (A2DP Sink, codec SBC)'), 'a2dp-sink': ('High Fidelity Playback (A2DP Sink, codec AAC)', 'High Fidelity Playback (A2DP Sink, codec AAC)')}}
version=2

[search-light]
animation-speed=100.0
background-color=(0.0, 0.0, 0.0, 0.80000000000000004)
blur-brightness=0.59999999999999998
blur-sigma=30.0
border-color=(0.23000000000000001, 0.23000000000000001, 0.23000000000000001, 1.0)
border-radius=1.6499999999999999
border-thickness=1
entry-font-size=1
monitor-count=1
preferred-monitor=0
scale-height=0.14999999999999999
scale-width=0.10000000000000001
shortcut-search=['<Super>space']
